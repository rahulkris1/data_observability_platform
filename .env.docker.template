# Docker Environment Variables
# Copy this file to .env.docker and modify as needed

# Application
APP_NAME=Data Observability Platform
APP_VERSION=0.1.0
DEBUG=False

# API
API_V1_PREFIX=/api/v1

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dop_user
POSTGRES_PASSWORD=dop_password
POSTGRES_DB=data_observability
DATABASE_URL=postgresql://dop_user:dop_password@postgres:5432/data_observability

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=False
MINIO_BUCKET_RAW=raw-data
MINIO_BUCKET_PROCESSED=processed-data
MINIO_BUCKET_AUDIT=audit-data

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Airflow
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin123

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=/api/v1
NEXT_PUBLIC_APP_NAME=Data Observability Platform
NEXT_PUBLIC_APP_VERSION=0.1.0
