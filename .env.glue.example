# AWS Glue Integration Environment Variables
# Copy this to your .env file and configure for AWS Glue support

# ============================================
# Execution Mode Configuration
# ============================================
# Options: "local" or "glue"
# - local: Uses local SparkSession with MinIO
# - glue: Uses AWS Glue with S3 storage
EXECUTION_MODE=local

# ============================================
# AWS Glue Configuration
# ============================================
# Required when EXECUTION_MODE=glue

# AWS Glue Job Name (e.g., dop-dataset-ingestion-job)
GLUE_JOB_NAME=

# AWS IAM Role ARN for Glue job execution
# Example: arn:aws:iam::123456789012:role/GlueServiceRole
GLUE_IAM_ROLE=

# S3 bucket for Glue job scripts
# Example: my-glue-scripts-bucket
GLUE_SCRIPT_BUCKET=

# Glue Worker Type
# Options: G.1X, G.2X, Standard
GLUE_WORKER_TYPE=G.1X

# Number of workers for Glue job
GLUE_NUMBER_OF_WORKERS=2

# Job timeout in minutes (default: 2880 = 48 hours)
GLUE_TIMEOUT=2880

# Max retries for failed jobs
GLUE_MAX_RETRIES=1

# Glue Security Configuration (optional)
GLUE_SECURITY_CONFIGURATION=

# S3 temp directory for Glue intermediate files
# Example: s3://my-glue-temp-bucket/temp/
GLUE_TEMP_DIR=

# ============================================
# AWS Credentials (if not using IAM roles)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ============================================
# S3 Storage Configuration (Glue mode)
# ============================================
# Required when STORAGE_PROVIDER=s3 or EXECUTION_MODE=glue
S3_BUCKET_RAW=dop-raw-data
S3_BUCKET_PROCESSED=dop-processed-data
S3_BUCKET_AUDIT=dop-audit-data

# ============================================
# Local Development Configuration
# ============================================
# Storage Provider: "minio" or "s3"
STORAGE_PROVIDER=minio

# PostgreSQL Database
DATABASE_URL=postgresql://dop_user:dop_password@localhost:5432/data_observability

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Local PySpark Configuration
SPARK_APP_NAME=DataObservabilityPlatform
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_LOG_LEVEL=WARN
