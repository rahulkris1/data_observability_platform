# Simplified local environment - SQLite only
APP_NAME=Data Observability Platform
APP_VERSION=0.1.0
DEBUG=True

# API
API_V1_PREFIX=/api/v1

# Use SQLite for local development (no PostgreSQL needed)
DATABASE_URL=sqlite:///./data_observability.db

# Local execution mode (no AWS Glue)
EXECUTION_MODE=local

# Disable CloudWatch
CLOUDWATCH_ENABLED=False
