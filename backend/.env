# Backend Environment Configuration

# Application
APP_NAME=Data Observability Platform
APP_VERSION=0.1.0
DEBUG=True

# API
API_V1_PREFIX=/api/v1

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dop_user
POSTGRES_PASSWORD=dop_password
POSTGRES_DB=data_observability
DATABASE_URL=postgresql://dop_user:dop_password@localhost:5432/data_observability

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=False
MINIO_BUCKET_RAW=raw-data
MINIO_BUCKET_PROCESSED=processed-data
MINIO_BUCKET_AUDIT=audit-data

# ============================================
# AWS CONFIGURATION
# ============================================
# Note: Leave empty for local development mode
# Fill in these values to enable AWS services

# AWS Credentials (required for S3, Glue, CloudWatch)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# AWS S3 Configuration (used when STORAGE_PROVIDER=s3)
S3_BUCKET_RAW=dop-raw-data
S3_BUCKET_PROCESSED=dop-processed-data
S3_BUCKET_AUDIT=dop-audit-data

# AWS Glue Configuration (used when EXECUTION_MODE=glue)
GLUE_JOB_NAME=
GLUE_IAM_ROLE=
GLUE_SCRIPT_BUCKET=
GLUE_WORKER_TYPE=G.1X
GLUE_NUMBER_OF_WORKERS=2
GLUE_TIMEOUT=2880
GLUE_MAX_RETRIES=1
GLUE_SECURITY_CONFIGURATION=
GLUE_TEMP_DIR=

# AWS CloudWatch Configuration
# Set CLOUDWATCH_ENABLED=True to publish metrics and logs to AWS CloudWatch
# Metrics are ALWAYS stored in PostgreSQL (dual storage)
# Logs are ALWAYS written to local files (dual logging)
CLOUDWATCH_ENABLED=False
CLOUDWATCH_NAMESPACE=DataObservabilityPlatform
CLOUDWATCH_LOG_GROUP=/aws/dataobservability/application

# ============================================
# SNOWFLAKE DATA WAREHOUSE
# ============================================
# Optional: Configure Snowflake for production data warehouse
# Leave empty if not using Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=

# ============================================
# AIRFLOW CONNECTIONS
# ============================================
# Airflow connection IDs for AWS and Snowflake integrations
AIRFLOW_AWS_CONN_ID=aws_default
AIRFLOW_SNOWFLAKE_CONN_ID=snowflake_default

# ============================================
# STORAGE PROVIDER CONFIGURATION
# ============================================
# Options: "minio" (local) or "s3" (AWS)
# - minio: Use local MinIO for development
# - s3: Use AWS S3 for production
STORAGE_PROVIDER=minio

# ============================================
# EXECUTION MODE CONFIGURATION
# ============================================
# Options: "local" or "glue"
# - local: Run PySpark locally for development
# - glue: Use AWS Glue for production data processing
EXECUTION_MODE=local
