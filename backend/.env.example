# Backend Environment Configuration Example

# Application
APP_NAME=Data Observability Platform
APP_VERSION=0.1.0
DEBUG=False

# API
API_V1_PREFIX=/api/v1

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dop_user
POSTGRES_PASSWORD=dop_password
POSTGRES_DB=data_observability
DATABASE_URL=postgresql://dop_user:dop_password@localhost:5432/data_observability

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Storage Provider Configuration
# Options: "minio" (local development) or "s3" (production/AWS)
STORAGE_PROVIDER=minio

# MinIO Object Storage (for local development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=False
MINIO_BUCKET_RAW=raw-data
MINIO_BUCKET_PROCESSED=processed-data
MINIO_BUCKET_AUDIT=audit-data

# AWS S3 Object Storage (for production)
# Only required when STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_RAW=dop-raw-data
S3_BUCKET_PROCESSED=dop-processed-data
S3_BUCKET_AUDIT=dop-audit-data
