# Backend Production Environment Configuration

# Application
APP_NAME=Data Observability Platform
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=production

# API
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL Database (Production)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dop_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=data_observability_prod
DATABASE_URL=postgresql://dop_prod_user:CHANGE_THIS_SECURE_PASSWORD@postgres:5432/data_observability_prod

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis Cache (Production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_THIS_SECURE_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_THIS_SECURE_REDIS_PASSWORD@redis:6379/0

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Storage Provider Configuration
# Options: "minio" (local/docker) or "s3" (production/AWS)
STORAGE_PROVIDER=minio

# MinIO Object Storage (Docker Production)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY
MINIO_SECURE=False
MINIO_BUCKET_RAW=raw-data-prod
MINIO_BUCKET_PROCESSED=processed-data-prod
MINIO_BUCKET_AUDIT=audit-data-prod

# AWS S3 Object Storage (for AWS production)
# Uncomment and configure when STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_REGION=us-east-1
# S3_BUCKET_RAW=dop-raw-data-prod
# S3_BUCKET_PROCESSED=dop-processed-data-prod
# S3_BUCKET_AUDIT=dop-audit-data-prod

# AWS CloudWatch (Optional)
# AWS_CLOUDWATCH_ENABLED=False
# AWS_CLOUDWATCH_LOG_GROUP=/dop/production
# AWS_CLOUDWATCH_LOG_STREAM=backend

# AWS Glue (Optional)
# AWS_GLUE_ENABLED=False
# AWS_GLUE_DATABASE=dop_production
# AWS_GLUE_CRAWLER_NAME=dop-production-crawler

# Celery Task Queue (Production)
CELERY_BROKER_URL=redis://:CHANGE_THIS_SECURE_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_THIS_SECURE_REDIS_PASSWORD@redis:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# Airflow Integration (Production)
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=CHANGE_THIS_AIRFLOW_PASSWORD

# Snowflake Data Warehouse (Optional)
# SNOWFLAKE_ACCOUNT=your_account
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_DATABASE=your_database
# SNOWFLAKE_SCHEMA=your_schema
# SNOWFLAKE_WAREHOUSE=your_warehouse
# SNOWFLAKE_ROLE=your_role

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=True
LOG_FILE_PATH=/app/logs/app.log
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=10

# Performance & Optimization
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
KEEP_ALIVE=5

# CORS Configuration (Production)
CORS_ORIGINS=["http://frontend:3000", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2
RETRY_MAX_DELAY=60

# Data Quality Thresholds
DATA_QUALITY_MIN_SCORE=0.7
FRESHNESS_WARNING_HOURS=24
FRESHNESS_CRITICAL_HOURS=48

# Monitoring & Alerting
ENABLE_METRICS=True
ENABLE_TRACING=False
METRICS_PORT=9090
