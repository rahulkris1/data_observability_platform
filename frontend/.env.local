# Frontend Environment Variables

# API Configuration
# Use relative URL to leverage Next.js proxy (configured in next.config.js)
# Next.js will forward /api/v1/* requests to http://localhost:8000/api/v1/*
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_VERSION=/api/v1

# Application
NEXT_PUBLIC_APP_NAME=Data Observability Platform
NEXT_PUBLIC_APP_VERSION=0.1.0
