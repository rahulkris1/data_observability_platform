# Frontend Production Environment Variables

# API Configuration
# In Docker production, use the internal service name
NEXT_PUBLIC_API_URL=http://backend:8000
NEXT_PUBLIC_API_VERSION=/api/v1

# Application
NEXT_PUBLIC_APP_NAME=Data Observability Platform
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_ENVIRONMENT=production

# Build Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Performance & Optimization
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# API Timeouts (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRY_ATTEMPTS=3

# Feature Flags
NEXT_PUBLIC_ENABLE_METRICS=true
NEXT_PUBLIC_ENABLE_PROFILING=true
NEXT_PUBLIC_ENABLE_DATA_QUALITY=true
NEXT_PUBLIC_ENABLE_SCHEMA_DRIFT=true
NEXT_PUBLIC_ENABLE_FRESHNESS=true

# Cache Configuration
NEXT_PUBLIC_CACHE_ENABLED=true
NEXT_PUBLIC_CACHE_TTL=300

# UI Configuration
NEXT_PUBLIC_ITEMS_PER_PAGE=20
NEXT_PUBLIC_MAX_FILE_SIZE=104857600
NEXT_PUBLIC_ALLOWED_FILE_TYPES=.csv,.json,.parquet,.avro

# Security
NEXT_PUBLIC_ENABLE_CSRF_PROTECTION=true

# Monitoring
NEXT_PUBLIC_LOG_LEVEL=warn
